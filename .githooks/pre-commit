#!/bin/sh
# Programmer 저장소 — 커밋 전 개인파일/비밀정보 차단
# 이 저장소는 PUBLIC이다. 허용 목록에 없는 파일은 커밋을 막는다.
# 설치: git config core.hooksPath .githooks   (PC마다 최초 1회)
# 우회(정말 필요할 때만): git commit --no-verify

# 색상은 터미널일 때만 넣는다. IntelliJ 커밋 창처럼 TTY가 아닌 곳에서는
# 이스케이프 코드가 깨진 글자로 보이므로 빈 문자열로 둔다.
if [ -t 1 ]; then
    R=$(printf '\033[31m'); Y=$(printf '\033[33m'); N=$(printf '\033[0m')
else
    R=''; Y=''; N=''
fi

# heredoc으로 읽어야 while이 서브셸에 안 들어가 blocked 값이 유지된다.
# core.quotepath=false → 한글 파일명이 \354\... 로 깨지지 않는다.
# IFS= + read -r → 공백 들어간 파일명도 한 줄로 온전히 읽힌다.
blocked=""
while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
        # ---- 허용: 풀이 코드 ----
        java/*.java|c/*.c|python/*.py) ;;
        # ---- 허용: 저장소 문서·설정 ----
        README.md|CLAUDE.md|.gitignore|.githooks/*) ;;
        .vscode/tasks.json|.vscode/settings.json) ;;
        c/.vscode/tasks.json|c/.vscode/launch.json) ;;
        # ---- 그 외 전부 차단 ----
        *) blocked="$blocked  $f
" ;;
    esac
done <<EOF
$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)
EOF

if [ -n "$blocked" ]; then
    printf '\n%s=== 커밋 차단 — 허용되지 않은 파일 ===%s\n\n' "$R" "$N"
    printf '%s' "$blocked"
    printf '\n이 저장소는 PUBLIC이며 코딩테스트 풀이 코드만 올린다.\n'
    printf '개인 메모/일기/문서는 옵시디언 볼트에 쓸 것.\n\n'
    printf '올려야 하는 코드 파일이면 .githooks/pre-commit 허용 목록에 추가하라.\n'
    printf '%s우회: git commit --no-verify (권장하지 않음)%s\n\n' "$Y" "$N"
    exit 1
fi

# 파일명이 멀쩡해도 "내용"에 비밀정보가 있을 수 있다.
leak=$(git diff --cached -U0 | grep -Ei \
    '^\+.*(sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|AIza[A-Za-z0-9_-]{30,}|AKIA[0-9A-Z]{16}|(password|api[_-]?key|secret|token)[[:space:]]*[=:][[:space:]]*[^[:space:]$#{)]{8,})')

if [ -n "$leak" ]; then
    printf '\n%s=== 커밋 차단 — 비밀정보로 보이는 값 ===%s\n\n' "$R" "$N"
    printf '%s\n' "$leak"
    printf '\n값을 지우고 다시 커밋하라. 이미 푸시했다면 키를 즉시 재발급할 것.\n'
    printf '%s오탐이면: git commit --no-verify%s\n\n' "$Y" "$N"
    exit 1
fi

exit 0
